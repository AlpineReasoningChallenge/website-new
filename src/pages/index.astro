---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, nextEvent, contests, classes, supporters, faq } from '../data/site';

import hallWide from '../assets/photos/triathlon-2026-hall-wide.jpg';
import organizers from '../assets/photos/organizers-2025.jpg';

const reg = nextEvent.registration;
const headline = 'Free STEM contests and classes, run by Calgary students.';
const words = headline.split(' ');

const programs = [
  {
    when: contests.rmjsc.date,
    upcoming: true,
    name: contests.rmjsc.name,
    href: contests.rmjsc.href,
    summary: contests.rmjsc.summary,
    facts: contests.rmjsc.facts,
  },
  {
    when: contests.sst.date,
    name: contests.sst.name,
    href: contests.sst.href,
    summary: contests.sst.summary,
    facts: contests.sst.facts,
  },
  {
    when: 'Dates to be announced',
    name: 'Classes and workshops',
    href: classes.href,
    summary: classes.summary,
    facts: ['Taught by ARC students', 'Free'],
  },
];

// One way to fill 7 beats, drawn under the sample problem: long, short, short, long, short.
const exampleRhythm = [2, 1, 1, 2, 1];

const problemParts = [
  {
    points: 1,
    answer: 21,
    text: 'State the number of ways Jimmy can compose a piece that is 7 beats long, using any combination of short and long notes.',
  },
  {
    points: 3,
    answer: null,
    text: 'The number above is a Fibonacci number. Can you prove why this problem is related to the Fibonacci sequence? (The Fibonacci sequence starts 1, 1, and then each term is the sum of the two previous terms; thus, the first few terms are 1, 1, 2, 3, 5, 8, 13, 21, …)',
  },
  {
    points: 5,
    answer: 27,
    text: 'How many different rhythms fill exactly 9 beats if Jimmy must use an even number of long notes?',
  },
  {
    points: 7,
    answer: 36,
    text: 'Jimmy would like his music to be less bland, so he has decided that he cannot use 3 short notes in a row. How many valid rhythms fill exactly 10 beats?',
  },
];

const day = [
  {
    title: 'You work as a team',
    text: 'You and your teammates solve each round together. Talking it over is the point.',
  },
  {
    title: 'Lunch is on us',
    text: 'We feed everyone and plan around dietary restrictions. Tell us about allergies when you register.',
  },
  {
    title: 'A workshop and a Kahoot',
    text: 'ARC’s student instructors teach a workshop, and everyone plays a Kahoot for extra prizes.',
  },
  {
    title: 'Awards before you leave',
    text: 'We hand out medals, trophies and certificates at the end of the day.',
  },
];

const description = `Free STEM contests and classes for Calgary youth, run by students. Next: ${nextEvent.name}, ${nextEvent.fullDate}. Free, lunch included.`;
---

<Base description={description}>
  <section class="hero" data-stage-section>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="intro-title">
          {
            words.map((word, i) => (
              <>
                <span class="word" style={`--i:${i}`}>
                  {word}
                </span>{' '}
              </>
            ))
          }
        </h1>
        <p class="lede intro" style="--d:420ms">
          Alpine Reasoning Challenge is a nonprofit run by junior high and high school students. Every
          contest, class and lunch is free.
        </p>
        <p class="hero-actions intro" style="--d:520ms">
          <a class="button" href="#programs">See what we run <Icon name="arrow" /></a>
          <a class="button button-quiet" href="#problem">Try a sample problem</a>
        </p>
      </div>

      <div class="stage stage-hero" data-stage="hero" aria-hidden="true">
        <img class="stage-still" src="/scene-hero.png" alt="" width="1200" height="900" />
      </div>

      <section class="next intro" style="--d:300ms" aria-labelledby="next-heading">
        <p class="next-date">
          <time datetime={nextEvent.isoDate}>
            <span class="next-day">{nextEvent.day}</span>
            <span class="next-month">{nextEvent.month} 2027</span>
            <span class="next-weekday">Sunday</span>
          </time>
          <span class="next-count" data-countdown={nextEvent.isoDate} hidden></span>
        </p>
        <div class="next-body">
          <h2 id="next-heading" class="next-name">
            <a href={nextEvent.href}><span class="visually-hidden">Next event: </span>{nextEvent.name}</a>
          </h2>
          <dl>
            {
              nextEvent.facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="next-actions">
          {
            reg.status === 'open' && (
              <a class="button" href={reg.url}>
                Register for {nextEvent.shortName}
              </a>
            )
          }
          {
            reg.status === 'soon' && (
              <a class="button" href={site.newsletter}>
                Email me when it opens
              </a>
            )
          }
          {
            reg.status === 'closed' && (
              <p class="next-closed">
                Registration is closed. For questions, email <a href={`mailto:${site.email}`}>{site.email}</a>.
              </p>
            )
          }
        </div>
      </section>
    </div>
  </section>

  <section class="section programs" id="programs" aria-labelledby="programs-heading">
    <div class="wrap">
      <div class="programs-main">
        <div class="section-head">
          <h2 id="programs-heading">What we run</h2>
          <p class="lede">
            Everything ARC runs is free. Contests happen in person in Calgary, and classes have run
            online.
          </p>
        </div>

        <ul class="program-list" role="list">
          {
            programs.map((item) => (
              <li>
                <a class="program" href={item.href}>
                  <span class:list={['program-when', { upcoming: item.upcoming }]}>{item.when}</span>
                  <span class="program-text">
                    <span class="program-name">{item.name}</span>
                    <span class="program-summary">{item.summary}</span>
                    <span class="program-facts">{item.facts.join(' · ')}</span>
                  </span>
                  <span class="program-arrow">
                    <Icon name="arrow" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="new-note">
          <strong>New this school year:</strong> general STEM events, more kinds of competitions and more
          classes. Nothing new has a date yet. <a href={site.newsletter}>Dates go out in the newsletter</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section problem-section" id="problem" aria-labelledby="problem-heading" data-stage-section>
    <div class="wrap problem-grid">
      <div class="problem-main">
        <div class="section-head">
          <h2 id="problem-heading" data-reveal>Try one of our problems</h2>
          <p class="lede">
            Part 1 needs nothing past counting. The later parts get harder quickly, and the last one is
            meant to take a while.
          </p>
        </div>

        <article class="problem">
          <header>
            <h3>Cabinet</h3>
            <p class="problem-meta">
              Summit STEM Triathlon 2026 · Algorithmic Thinking · Easy · Proposed by Danny Wang
            </p>
          </header>
          <p>
            Jimmy is composing a piece of music. In his piece, he would like to create a rhythm that only
            uses short notes, which have a length of 1 beat each, and long notes, which have a length of 2
            beats each. Note that notes in his rhythm cannot overlap (only one note at a time may be
            played) and there can be no gaps between each note (once a note ends, another note must
            immediately begin, unless the piece has ended).
          </p>

          <figure class="rhythm" data-rhythm>
            <div class="beats" aria-hidden="true">
              {exampleRhythm.map((length) => <span class={length === 2 ? 'long' : 'short'}>{length}</span>)}
            </div>
            <figcaption>
              <span class="rhythm-caption" aria-live="polite">
                One way to fill 7 beats: long, short, short, long, short.
              </span>
              <button type="button" class="button button-quiet button-small rhythm-next" hidden>
                Try another rhythm
              </button>
            </figcaption>
          </figure>

          <ol class="parts" role="list">
            {
              problemParts.map((part, i) => (
                <li>
                  <span class="points">
                    {part.points} {part.points === 1 ? 'pt' : 'pts'}
                  </span>
                  <div>
                    <p>{part.text}</p>
                    {part.answer !== null && (
                      <form class="check" data-answer={part.answer} hidden>
                        <label class="visually-hidden" for={`answer-${i}`}>
                          Your answer to part {i + 1}
                        </label>
                        <input id={`answer-${i}`} type="text" inputmode="numeric" autocomplete="off" placeholder="Your answer" />
                        <button type="submit" class="button button-quiet button-small">Check</button>
                        <span class="check-result" role="status"></span>
                      </form>
                    )}
                  </div>
                </li>
              ))
            }
          </ol>

          <details>
            <summary>Show the answers</summary>
            <div class="details-body">
              <p>
                7 beats: 21 rhythms. 9 beats with an even number of long notes: 27. 10 beats with no three
                short notes in a row: 36.
              </p>
              <p>
                For the proof, look at the last note. If it is short, what comes before it is a rhythm one
                beat shorter. If it is long, what comes before it is a rhythm two beats shorter.
              </p>
            </div>
          </details>
        </article>
        <p class="problem-more">
          <a class="arrow-link" href="/archive/">More past papers <Icon name="arrow" /></a>
        </p>
      </div>
      <div class="problem-side" aria-hidden="true">
        <div class="stage stage-rhythm" data-stage="rhythm" data-stage-kind="pinned"></div>
      </div>
    </div>
  </section>

  <section class="section day-section" aria-labelledby="day-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="day-heading">What a contest day looks like</h2>
        <p class="lede">
          Each in-person contest takes one day. Past contests started between 9 and 10 in the morning and
          finished by 4 in the afternoon.
        </p>
      </div>

      <figure class="day-photo">
        <Image
          src={hallWide}
          alt="A wide view of a hall where about a hundred students work in teams at round tables."
          widths={[640, 1080, 1600, 2200, 2800]}
          sizes="(min-width: 80rem) 76rem, calc(100vw - 2rem)"
        />
        <figcaption>Summit STEM Triathlon, January 2026</figcaption>
      </figure>

      <ul class="day-list" role="list">
        {
          day.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section about" aria-labelledby="about-heading">
    <div class="wrap about-grid">
      <figure class="about-photo">
        <Image
          src={organizers}
          alt="Seven ARC organizers standing in front of a chalkboard covered in math."
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 80rem) 37rem, (min-width: 52rem) calc(50vw - 3rem), calc(100vw - 2rem)"
        />
        <figcaption>ARC organizers at RMJSC 2025</figcaption>
      </figure>
      <div class="about-copy">
        <h2 id="about-heading">Run by students</h2>
        <p class="lede">
          Every ARC organizer is a junior high or high school student volunteer. We write the problems and
          teach the workshops ourselves.
        </p>
        <p>
          A group of high school students started ARC in Calgary in May 2023, and it became an incorporated
          Alberta nonprofit in October 2024. The Rocky Mountain Junior Science Contest is older than we are.
          Another group of students started it in 2020 because Calgary had plenty of math contests and very
          few science ones. We partnered with them in 2024 and have run it since.
        </p>
        <p>We recruit new organizers every summer for our content, marketing and outreach teams.</p>
        <p class="about-links">
          <a class="arrow-link" href="/about/">Meet the team <Icon name="arrow" /></a>
          <a class="arrow-link" href="/about/#join">How to join <Icon name="arrow" /></a>
        </p>
      </div>
    </div>
  </section>

  <section class="section support" aria-labelledby="support-heading">
    <div class="wrap support-grid">
      <div>
        <h2 id="support-heading">Free, because sponsors pay for it</h2>
        <p class="lede">
          Sponsors and donors cover rooms, food, printing and prizes, so no student pays to take part.
        </p>
        <p>
          <a class="arrow-link" href="/sponsors/">Sponsor or donate <Icon name="arrow" /></a>
        </p>
      </div>
      <div>
        <h3>Past and present supporters</h3>
        <ul class="supporters" role="list">
          {supporters.map((name) => <li>{name}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-heading">
    <div class="wrap faq-grid">
      <div>
        <h2 id="faq-heading">For parents and teachers</h2>
        <p class="lede">
          Teachers can email <a href={`mailto:${site.email}`}>{site.email}</a> for event details to share
          with their students.
        </p>
      </div>
      <div class="faq-list">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="details-body">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-heading">
    <div class="wrap">
      <div class="cta-panel">
        <div>
          <h2 id="cta-heading">Hear about the next contest first</h2>
          <p>
            We announce new events and open registration in our newsletter. We also post on Instagram, and
            you can ask us anything on Discord.
          </p>
        </div>
        <p class="cta-actions">
          <a class="button" href={site.newsletter}>Join the newsletter</a>
          <a class="button button-quiet" href={site.instagram}>Instagram</a>
          <a class="button button-quiet" href={site.discord}>Discord</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Opening */

  /* The right column is the 3D lane: the logo rests there, then flies straight down it. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-areas:
      'copy stage'
      'next stage';
    column-gap: clamp(2rem, 4vw, 4.5rem);
    padding-top: min(clamp(2rem, 1.25rem + 3vw, 4rem), 4.5vh);
  }

  .hero-copy {
    grid-area: copy;
  }

  h1 {
    hyphens: manual;
    max-width: 16ch;
  }

  /* On shorter laptop screens the headline scales with height too, so the event panel stays in view. */
  @media (min-width: 52.0625rem) {
    h1 {
      font-size: min(var(--text-h1), 7.6vh);
    }

    .hero-copy .lede {
      margin-top: min(var(--space-5), 2.6vh);
    }

    .hero-actions {
      margin-top: min(var(--space-6), 3vh);
    }

    .next {
      margin-top: min(clamp(1.5rem, 1rem + 2vw, 2.5rem), 3vh);
    }
  }

  .hero-copy .lede {
    margin-top: var(--space-6);
    max-width: 29em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .stage {
    position: relative;
  }

  .stage-hero {
    grid-area: stage;
    align-self: start;
    height: clamp(20rem, 38vw, 34rem);
  }

  .stage-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 500ms var(--ease-out);
  }

  /* Next event */

  .next {
    grid-area: next;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'date body'
      'date actions';
    align-items: start;
    gap: var(--space-4) clamp(1.25rem, 2.5vw, 2.25rem);
    margin-top: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    padding: clamp(1.25rem, 2.2vw, 1.75rem) clamp(1.25rem, 2.6vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line-soft),
      var(--shadow-1);
  }

  .next-date {
    grid-area: date;
    align-self: stretch;
    padding-right: clamp(1.25rem, 2.5vw, 2.25rem);
    border-right: 1px solid var(--line-soft);
  }

  .next-body {
    grid-area: body;
  }

  .next-date time {
    display: grid;
    line-height: 1;
  }

  .next-day {
    color: var(--teal);
    font-size: clamp(3.25rem, 2.6rem + 2.4vw, 4.5rem);
    font-weight: 640;
    font-stretch: 110%;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .next-month {
    margin-top: var(--space-2);
    color: var(--ink);
    font-weight: 600;
  }

  .next-weekday {
    margin-top: var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .next-count {
    display: block;
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .next-count[hidden] {
    display: none;
  }

  .next .next-name {
    color: var(--ink);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    font-weight: 620;
    font-stretch: 104%;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .next .next-name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .next .next-name a:hover {
    text-decoration-color: var(--teal);
  }

  .next dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-4);
  }

  .next dl div {
    display: grid;
  }

  .next dt {
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .next dd {
    color: var(--ink);
    font-weight: 560;
  }

  .next-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .next-closed {
    color: var(--ink);
    font-weight: 560;
  }

  /* What we run */

  .programs-main {
    max-width: 46rem;
  }

  .program-list {
    border-top: 1px solid var(--line);
  }

  .program-list li {
    border-bottom: 1px solid var(--line);
  }

  .program {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-4);
    margin-inline: calc(var(--space-4) * -1);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .program-when {
    padding-top: 0.2em;
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .program-when.upcoming {
    color: var(--teal);
    font-weight: 600;
  }

  .program-text {
    display: grid;
    gap: var(--space-2);
  }

  .program-name {
    color: var(--ink);
    font-size: var(--text-h3);
    font-weight: 600;
    font-stretch: 104%;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .program-summary {
    color: var(--ink-2);
  }

  .program-facts {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .program-arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--teal);
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .program:hover {
      background: var(--surface);
      box-shadow: var(--shadow-1);
    }

    .program:hover .program-arrow {
      transform: translateX(4px);
      background: var(--teal);
      color: #fff;
    }
  }

  .new-note {
    margin-top: var(--space-6);
    color: var(--ink-2);
  }

  .new-note strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Sample problem */

  .problem-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .problem-side {
    position: relative;
  }

  .stage-rhythm {
    position: sticky;
    top: 18vh;
    height: 52vh;
  }

  .problem {
    padding: clamp(1.25rem, 3.5vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line-soft),
      var(--shadow-1);
  }

  .problem header {
    margin-bottom: var(--space-4);
  }

  .problem-meta {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .problem > p {
    color: var(--ink);
  }

  .rhythm {
    margin-block: var(--space-6);
  }

  .beats {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
    max-width: 26rem;
  }

  .beats :global(span) {
    display: grid;
    place-items: center;
    height: 2.75rem;
    border-radius: 8px;
    background: var(--surface-soft);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .beats :global(span) {
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      translate var(--dur-fast) var(--ease-out);
  }

  .beats :global(span.is-playing) {
    box-shadow: 0 0 0 2px var(--teal-logo);
    translate: 0 -2px;
  }

  .beats :global(.long) {
    grid-column: span 2;
    background: var(--teal);
    box-shadow: none;
    color: #fff;
  }

  .rhythm figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .rhythm-next[hidden] {
    display: none;
  }

  .parts {
    border-top: 1px solid var(--line-soft);
  }

  .parts li {
    display: grid;
