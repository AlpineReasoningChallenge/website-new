---
import Icon from './Icon.astro';
import { nav, site, nextEvent } from '../data/site';

const path = Astro.url.pathname;
const reg = nextEvent.registration;
const cta =
  reg.status === 'open'
    ? { label: `Register for ${nextEvent.shortName}`, href: reg.url }
    : { label: 'Get updates', href: site.newsletter };
---

<header class="site-header">
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="/">
        <img src="/logo-on-light.svg" alt="" width="84" height="47" />
        <span>{site.name}</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="when-closed"><Icon name="menu" /></span>
        <span class="when-open"><Icon name="close" /></span>
        <span>Menu</span>
      </button>

      <nav id="site-nav" class="site-nav" aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="button button-small" href={cta.href}>{cta.label}</a>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('.site-header');
    const toggle = header && header.querySelector('.menu-toggle');
    if (!toggle) return;
    const setOpen = (open) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 64.0625rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  })();
</script>

<style>
  /* A frosted bar that floats over the page. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-top: var(--space-3);
    view-transition-name: site-header;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-h);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.94);
    box-shadow:
      inset 0 0 0 1px rgb(211 222 223 / 0.9),
      0 1px 2px rgb(12 26 31 / 0.04);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .site-header[data-scrolled] .bar {
    background: rgb(255 255 255 / 0.96);
    box-shadow:
      inset 0 0 0 1px rgb(211 222 223 / 0.9),
      0 14px 34px -18px rgb(12 26 31 / 0.3);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .bar,
    .site-header[data-scrolled] .bar {
      background: rgb(255 255 255 / 0.97);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    font-weight: 620;
    font-stretch: 106%;
    font-size: 1.0625rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .brand img {
    width: 4.75rem;
    height: auto;
  }

  .brand:hover {
    color: var(--ink);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .site-nav li a,
  .site-nav .button {
    white-space: nowrap;
  }

  .site-nav li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 520;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .site-nav li a:hover {
    background: rgb(12 26 31 / 0.05);
    color: var(--ink);
  }

  .site-nav li a[aria-current='page'] {
    color: var(--ink);
    background: rgb(11 117 102 / 0.08);
  }

  .menu-toggle {
    display: none;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .menu-toggle span {
    display: inline-flex;
  }

  .menu-toggle .when-open,
  .menu-toggle[aria-expanded='true'] .when-closed {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .when-open {
    display: inline-flex;
  }

  @media (max-width: 64rem) {
    .site-header {
      position: relative;
      padding-top: var(--space-2);
    }

    .bar {
      flex-wrap: wrap;
      gap: var(--space-3);
      min-height: 3.5rem;
      padding-left: var(--space-4);
    }

    .brand {
      flex: 1 1 0;
      min-width: 0;
      font-size: 1rem;
    }

    .brand img {
      width: 4rem;
    }

    .brand span {
      max-width: 9.5em;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    .site-nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding: 0 var(--space-2) var(--space-3);
    }

    :global(.js) .site-nav {
      display: none;
    }

    :global(.js) .site-header[data-open] .site-nav {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav li a {
      display: flex;
      min-height: 3rem;
      padding: 0 var(--space-2);
      border-top: 1px solid var(--line-soft);
      border-radius: 0;
      font-size: var(--text-base);
    }

    .site-nav li a[aria-current='page'] {
      background: none;
      color: var(--teal);
    }

    .site-nav .button {
      align-self: flex-start;
    }

    :global(html:not(.js)) .site-nav ul {
      flex-direction: row;
      flex-wrap: wrap;
    }

    :global(html:not(.js)) .site-nav li a {
      border-top: 0;
    }
  }

  @media (max-width: 18rem) {
    .brand {
      flex: 1 1 100%;
      flex-wrap: wrap;
    }
  }

  @media (forced-colors: active) {
    .bar {
      border: 1px solid CanvasText;
    }
  }
</style>
