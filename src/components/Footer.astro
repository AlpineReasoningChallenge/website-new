---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <div class="wrap top">
    <div class="about">
      <img src="/logo-on-dark.svg" alt="" width="150" height="84" loading="lazy" />
      <p>
        {site.name} is a nonprofit run by students in Calgary, Alberta. We make free STEM contests and
        classes for young people.
      </p>
    </div>

    <nav aria-label="Footer" class="columns">
      <div>
        <h2>What we run</h2>
        <ul role="list">
          <li><a href="/rmjsc/">Junior Science Contest</a></li>
          <li><a href="/sst/">Summit STEM Triathlon</a></li>
          <li><a href="/classes/">Classes</a></li>
          <li><a href="/archive/">Past papers</a></li>
        </ul>
      </div>
      <div>
        <h2>ARC</h2>
        <ul role="list">
          <li><a href="/about/">About and team</a></li>
          <li><a href="/about/#join">Join the team</a></li>
          <li><a href="/sponsors/">Sponsor or donate</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Follow</h2>
        <ul role="list">
          <li><a href={site.newsletter}>Newsletter</a></li>
          <li><a href={site.instagram}>Instagram</a></li>
          <li><a href={site.discord}>Discord</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap">
    <p class="bottom">
      {`© ${year} ${site.name}.`} An incorporated Alberta nonprofit run by student volunteers in Calgary.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--night);
    color: var(--on-night);
    font-size: var(--text-sm);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-7);
  }

  .about img {
    width: 9.5rem;
    height: auto;
    margin-bottom: var(--space-5);
  }

  .about p {
    max-width: 30em;
    color: var(--on-night-2);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--teal-logo);
  }

  a {
    display: inline-block;
    padding-block: 0.625rem;
    line-height: 1.5;
    color: var(--on-night);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  a:hover {
    color: var(--teal-logo);
  }

  .bottom {
    padding-block: var(--space-5);
    border-top: 1px solid rgb(169 191 189 / 0.18);
    color: var(--on-night-2);
  }

  @media (max-width: 52rem) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
      padding-block: var(--space-7) var(--space-6);
    }

    .columns {
      grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr));
    }
  }
</style>
