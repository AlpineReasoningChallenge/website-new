// Cloudflare Workers static-assets config. `npm run build` writes the site to dist/,
// and Cloudflare serves those files. No server code runs.
{
  "name": "website-new",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
